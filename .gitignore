# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Superdesign workspace files
.superdesign/

# Local job application files. Keep only the public resume deployable.
/public/resume/*.docx
/public/resume/*Cover-Letter*
/public/resume/*cover-letter*
/public/resume/*Cover_Letter*
/public/resume/~$*
/public/resume/Jaehoon-Jung-CV-1.pdf
