{
  "name": "frontend",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "cross-env PORT=10001 next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,mdx}\"",
    "nb2mdx": "node scripts/nb2mdx.cjs",
    "deploy": "next build && echo \"\" > out/.nojekyll && git add -f out/ && git commit -m \"Deploy\" && git subtree push --prefix out origin gh-pages",
    "vercel-deploy": "next build && next export"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/glob": "^8.1.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "glob": "^11.0.1",
    "gray-matter": "^4.0.3",
    "next": "^16.1.2",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.2",
    "eslint-plugin-prettier": "^5.0.0",
    "postcss": "^8",
    "prettier": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
